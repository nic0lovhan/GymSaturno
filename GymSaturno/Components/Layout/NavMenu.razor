@* Barra superior del menú lateral con el nombre y logotipo del gimnasio *@
<div class="top-row ps-3 navbar navbar-dark bg-dark border-bottom border-warning border-3">
    <div class="container-fluid">
        @* Enlace hacia la ruta raíz ("") *@
        <a class="navbar-brand fw-bold text-warning" href="">🪐 Gym Saturno</a>
    </div>
</div>

@* Botón hamburguesa oculto para desplegar el menú en pantallas pequeñas o celulares *@
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

@* Contenedor desplazable de enlaces; cierra el menú móvil automáticamente al hacer clic *@
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    @* Columna vertical de navegación *@
    <nav class="nav flex-column">
        @* Enlace al Panel Principal; Match.All ilumina el botón solo cuando la URL es exactamente "/" *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Panel Principal
            </NavLink>
        </div>

        @* Enlaces NavLink hacia cada uno de los 6 módulos operativos del sistema *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="socios">
                <span class="bi bi-people-fill" aria-hidden="true"></span> Gestión de Socios
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="membresias">
                <span class="bi bi-card-checklist" aria-hidden="true"></span> Control de Membresías
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="pagos">
                <span class="bi bi-cash-stack" aria-hidden="true"></span> Historial de Pagos
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="asistencias">
                <span class="bi bi-calendar-check" aria-hidden="true"></span> Registro de Asistencias
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="personal">
                <span class="bi bi-person-arms-up" aria-hidden="true"></span> Staff y Entrenadores
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ventas">
                <span class="bi bi-receipt" aria-hidden="true"></span> Control de Ventas
            </NavLink>
        </div>
    </nav>
</div>