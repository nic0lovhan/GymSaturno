@* Dos rutas posibles: /pagos normal o /pagos/5 cuando se recibe el ID de un adeudo *@
@page "/pagos"
@page "/pagos/{PagoId:int?}"
@rendermode InteractiveServer
@inject IRepositorioGym Repo

<PageTitle>Historial de Pagos - Gym Saturno</PageTitle>

<div class="container my-4">
    <h2 class="mb-3">Historial de Pagos y Abono a Saldos Pendientes</h2>

    @* Tarjeta para registrar abonos a deudas pendientes *@
    <div class="card border-info mb-4 shadow-sm">
        <div class="card-header bg-dark text-white">Registrar Abono o Liquidación de Saldo</div>
        <div class="card-body">
            @* Si nadie debe dinero, muestra mensaje verde y oculta el formulario *@
            @if (!pagosConAdeudo.Any())
            {
                <div class="alert alert-success mb-0">No existen saldos pendientes por cobrar en este momento.</div>
            }
            else
            {
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Seleccionar Adeudo / Folio:</label>
                        @* @bind guarda el Id elegido y @bind:after dispara AlCambiarPagoSeleccionado automáticamente *@
                        <select class="form-select" @bind="pagoSeleccionadoId" @bind:after="AlCambiarPagoSeleccionado">
                            <option value="0">-- Selecciona un folio con adeudo --</option>
                            @foreach (var p in pagosConAdeudo)
                            {
                                <option value="@p.Id">@p.Folio - @p.Socio?.NombreCompleto (Debe: $@p.MontoPendiente.ToString("F2"))</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Empleado que recibe el pago:</label>
                        <select class="form-select" @bind="empleadoId">
                            <option value="0">-- Selecciona Empleado --</option>
                            @foreach (var emp in empleados)
                            {
                                <option value="@emp.Id">@emp.CodigoEmpleado - @emp.NombreEmpleado</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">
                            Monto a Pagar (Máximo: $@(pagoActual?.MontoPendiente.ToString("F2") ?? "0.00")):
                        </label>
                        @* Input numérico cuyo límite máximo (max) es el saldo pendiente del folio elegido *@
                        <input type="number" class="form-control" min="1"
                               max="@(pagoActual?.MontoPendiente ?? 0)"
                               @bind="montoAAbonar"
                               disabled="@(pagoActual == null)" />
                    </div>
                </div>

                @* Alertas dinámicas de validación o confirmación *@
                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger">@mensajeError</div>
                }
                @if (!string.IsNullOrEmpty(mensajeExito))
                {
                    <div class="alert alert-success">@mensajeExito</div>
                }

                <button class="btn btn-success" @onclick="GuardarAbono" disabled="@(pagoActual == null)">
                    Guardar Pago y Registrar Fecha/Hora
                </button>
            }
        </div>
    </div>

    <h4>Historial General de Pagos</h4>
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="text-nowrap">Folio</th>
                    <th class="text-nowrap">Número de Socio</th>
                    <th style="min-width: 160px;">Nombre del Socio</th>
                    <th style="min-width: 150px;">Concepto</th>
                    <th class="text-nowrap">Total Pagado</th>
                    <th class="text-nowrap">Saldo Pendiente</th>
                    <th class="text-nowrap">Fecha Límite</th>
                    <th class="text-nowrap">Último Movimiento</th>
                </tr>
            </thead>
            <tbody>
                @* Lista histórica completa de todos los pagos *@
                @foreach (var p in todosLosPagos)
                {
                    <tr>
                        <td class="fw-bold text-nowrap">@p.Folio</td>
                        <td class="fw-bold text-nowrap">@p.Socio?.Matricula</td>
                        <td class="text-break">@p.Socio?.NombreCompleto</td>
                        <td class="text-break">@p.Concepto</td>
                        <td class="text-success fw-bold text-nowrap">$@p.MontoPagado.ToString("F2")</td>
                        <td class="@(p.MontoPendiente > 0 ? "text-danger fw-bold" : "text-muted") text-nowrap">
                            $@p.MontoPendiente.ToString("F2")
                        </td>
                        <td class="text-nowrap">@p.FechaLimite.ToString("dd/MM/yyyy")</td>
                        <td class="text-nowrap">@p.FechaHoraTransaccion.ToString("dd/MM/yyyy hh:mm tt")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    // Parámetro opcional recibido por la URL (/pagos/{PagoId})
    [Parameter] public int? PagoId { get; set; }

    private List<Pago> todosLosPagos = new();
    private List<Empleado> empleados = new();

    // Variables del formulario de abono
    private int pagoSeleccionadoId = 0;
    private int empleadoId = 0;
    private decimal montoAAbonar = 0;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;

    // Filtra solo los pagos con deuda pendiente
    private List<Pago> pagosConAdeudo => todosLosPagos.Where(p => p.MontoPendiente > 0).ToList();
    // Busca el objeto Pago correspondiente al folio elegido
    private Pago? pagoActual => pagosConAdeudo.FirstOrDefault(p => p.Id == pagoSeleccionadoId);

    // Carga pagos y empleados al entrar; si viene un PagoId en la URL, lo preselecciona
    protected override async Task OnInitializedAsync()
    {
        todosLosPagos = await Repo.GetPagosAsync();
        empleados = await Repo.GetEmpleadosAsync();

        if (PagoId.HasValue && PagoId.Value > 0)
        {
            pagoSeleccionadoId = PagoId.Value;
            AlCambiarPagoSeleccionado();
        }
    }

    // Coloca automáticamente el saldo pendiente completo como monto sugerido a abonar
    private void AlCambiarPagoSeleccionado()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
        montoAAbonar = pagoActual?.MontoPendiente ?? 0;
    }

    // Valida reglas de cobro, guarda el abono en SQL Server y refresca la tabla
    private async Task GuardarAbono()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (pagoActual == null)
        {
            mensajeError = "Selecciona un folio con saldo pendiente.";
            return;
        }
        if (empleadoId == 0)
        {
            mensajeError = "Selecciona el empleado que está cobrando el abono.";
            return;
        }
        if (montoAAbonar <= 0)
        {
            mensajeError = "El monto a pagar debe ser mayor a $0.00.";
            return;
        }
        if (montoAAbonar > pagoActual.MontoPendiente)
        {
            mensajeError = $"No puedes cobrar más del saldo pendiente (${pagoActual.MontoPendiente:F2} MXN).";
            return;
        }

        await Repo.RegistrarAbonoPagoAsync(pagoActual.Id, montoAAbonar, empleadoId);

        mensajeExito = $"Pago de ${montoAAbonar:F2} registrado correctamente el {DateTime.Now:dd/MM/yyyy hh:mm tt}.";
        todosLosPagos = await Repo.GetPagosAsync();
        pagoSeleccionadoId = 0;
        montoAAbonar = 0;
    }
}