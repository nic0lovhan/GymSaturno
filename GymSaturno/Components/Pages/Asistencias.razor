@* Define la URL de esta página: /asistencias *@
@page "/asistencias"
@* Activa la interactividad en tiempo real con el servidor *@
@rendermode InteractiveServer
@* Inyecta el repositorio para consultar socios y guardar asistencias *@
@inject IRepositorioGym Repo

@* Título que se muestra en la pestaña del navegador *@
<PageTitle>Registro de Asistencias - Gym Saturno</PageTitle>

<div class="container my-4">
    <h2 class="mb-3">Bitácora Digital de Asistencias</h2>

    @* Tarjeta del formulario de control de acceso *@
    <div class="card border-info mb-4 shadow-sm">
        <div class="card-header bg-dark text-white">Control de Acceso en Recepción</div>
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-8">
                    <label class="form-label fw-bold">Seleccionar Socio que ingresa:</label>
                    @* Lista desplegable vinculada (@bind) a la variable C# socioId *@
                    <select class="form-select" @bind="socioId">
                        <option value="0">-- Selecciona un socio --</option>
                        @* Recorre la lista socios y crea una opción por cada socio registrado *@
                        @foreach (var s in socios)
                        {
                            <option value="@s.Id">@s.Matricula - @s.NombreCompleto</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 mt-2">
                    @* Ejecuta RegistrarEntrada al dar clic; se bloquea (disabled) si PuedeRegistrarEntrada es falso *@
                    <button class="btn btn-primary w-100" @onclick="RegistrarEntrada" disabled="@(!PuedeRegistrarEntrada)">
                        Marcar Entrada Ahora
                    </button>
                </div>
            </div>

            @* Si ya se eligió un socio en el select, evalúa si tiene permiso para entrar *@
            @if (socioSeleccionado != null)
            {
                <div class="mt-3">
                    @if (TieneMembresiaActiva)
                    {
                        @* Alerta verde cuando su última membresía está vigente *@
                        <div class="alert alert-success mb-0">
                            <strong>Acceso Permitido:</strong> @socioSeleccionado.NombreCompleto cuenta con membresía <strong>Activa</strong> (Vence el @UltimaMembresia!.FechaVencimiento.ToString("dd/MM/yyyy")).
                        </div>
                    }
                    else
                    {
                        @* Alerta roja cuando no tiene plan o su plan ya venció *@
                        <div class="alert alert-danger mb-0">
                            <strong>Acceso Denegado:</strong> @socioSeleccionado.NombreCompleto <strong>no tiene una membresía activa</strong> (Estatus: @EstatusMembresiaSeleccionada). Debe renovar o adquirir un plan antes de registrar su asistencia.
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* Contenedor responsivo para la tabla de historial *@
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="text-nowrap">Fecha</th>
                    <th class="text-nowrap">Hora</th>
                    <th class="text-nowrap">Número de Socio</th>
                    <th style="min-width: 180px;">Socio</th>
                    <th class="text-nowrap">Estatus de Membresía</th>
                </tr>
            </thead>
            <tbody>
                @* Recorre cada registro de asistencia guardado en la base de datos *@
                @foreach (var a in asistencias)
                {
                    // Busca la membresía más reciente del socio para mostrar su estatus actual
                    var planActual = a.Socio?.Membresias.OrderByDescending(m => m.FechaVencimiento).FirstOrDefault();
                    string estatus = planActual?.Estatus ?? "Sin Plan";
                    <tr>
                        <td class="text-nowrap">@a.FechaHora.ToString("dd/MM/yyyy")</td>
                        <td class="text-nowrap">@a.FechaHora.ToString("hh:mm tt")</td>
                        <td class="fw-bold text-nowrap">@a.Socio?.Matricula</td>
                        <td class="text-break">@a.Socio?.NombreCompleto</td>
                        <td class="text-nowrap">
                            @* Pinta la etiqueta verde si es Activa o roja en caso contrario *@
                            <span class="badge @(estatus == "Activa" ? "bg-success" : "bg-danger")">
                                @estatus
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    // Variable entera que guarda el Id del socio seleccionado en el <select>
    private int socioId = 0;
    // Listas en memoria que almacenan los datos traídos de SQL Server
    private List<Socio> socios = new();
    private List<Asistencia> asistencias = new();

    // Propiedades calculadas en tiempo real según el socio elegido:
    // Busca el objeto Socio completo cuyo Id coincida con socioId
    private Socio? socioSeleccionado => socios.FirstOrDefault(s => s.Id == socioId);
    // Obtiene la membresía con la fecha de vencimiento más lejana de ese socio
    private Membresia? UltimaMembresia => socioSeleccionado?.Membresias.OrderByDescending(m => m.FechaVencimiento).FirstOrDefault();
    // Devuelve el estatus de esa membresía o "Sin Plan" si nunca ha comprado una
    private string EstatusMembresiaSeleccionada => UltimaMembresia?.Estatus ?? "Sin Plan";
    // Verdadero únicamente si el estatus es exactamente "Activa"
    private bool TieneMembresiaActiva => EstatusMembresiaSeleccionada == "Activa";
    // Habilita el botón de entrada solo si hay un socio elegido y su plan está activo
    private bool PuedeRegistrarEntrada => socioSeleccionado != null && TieneMembresiaActiva;

    // Método del ciclo de vida de Blazor: se ejecuta automáticamente al entrar a la página
    protected override async Task OnInitializedAsync()
    {
        socios = await Repo.GetSociosAsync();
        asistencias = await Repo.GetAsistenciasAsync();
    }

    // Guarda la entrada en SQL Server con la fecha/hora actual y recarga la tabla
    private async Task RegistrarEntrada()
    {
        if (PuedeRegistrarEntrada)
        {
            await Repo.RegistrarAsistenciaAsync(new Asistencia
            {
                SocioId = socioId,
                FechaHora = DateTime.Now
            });
            socioId = 0;
            asistencias = await Repo.GetAsistenciasAsync();
        }
    }
}